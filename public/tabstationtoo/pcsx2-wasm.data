SLUS-20424:
  name: "The Scorpion King - Rise of the Akkadian"
  name-sort: "Scorpion King, The - Rise of the Akkadian"
  region: "NTSC-U"
  compat: 5
SLUS-20425:
  name: "Nickelodeon SpongeBob SquarePants - Revenge of the Flying Dutchman"
