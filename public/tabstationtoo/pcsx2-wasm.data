SLPM-65223:
  name: "ãƒˆãƒ©ã‚¤ã‚¢ãƒ³ã‚°ãƒ«ãƒ»ã‚¢ã‚²ã‚¤ãƒ³"
  name-sort: "ã¨ã‚‰ã„ã‚ã‚“ãã‚‹ã‚ã’ã„ã‚“"
  name-en: "Triangle Again"
  region: "NTSC-J"
