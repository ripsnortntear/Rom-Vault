diff --git a/libgambatte/libretro/libretro.cpp b/libgambatte/libretro/libretro.cpp
index fca1d72..ad50a2a 100644
--- a/libgambatte/libretro/libretro.cpp
+++ b/libgambatte/libretro/libretro.cpp
@@ -85,6 +85,51 @@ static const struct retro_netpacket_callback link_iface = {
    "gamevault-link-1" /* both ends must speak the same packets */
 };
 
+#ifdef __EMSCRIPTEN__
+#include <emscripten.h>
+
+static void ejs_netpacket_send_cb(int flags, const void* buf, size_t len, uint16_t client_id)
+{
+   if (!buf || len < 3) return;
+   const unsigned char* p = (const unsigned char*)buf;
+   char js[256];
+   snprintf(js, sizeof(js),
+      "if(typeof window!='undefined'){"
+      "if(window.parent&&window.parent!==window)window.parent.postMessage({type:'VAULT_LINK_PACKET_OUT',kind:%d,data:%d,fast:%d},'*');"
+      "if(window.EJS_onLinkPacket)window.EJS_onLinkPacket(%d,%d,%d);}",
+      (int)p[0], (int)p[1], (int)p[2], (int)p[0], (int)p[1], (int)p[2]);
+   emscripten_run_script(js);
+}
+
+static void ejs_netpacket_poll_cb(void)
+{
+   emscripten_run_script("if(typeof window!='undefined'&&window.EJS_pollLinkPackets)window.EJS_pollLinkPackets();");
+}
+
+extern "C" {
+EMSCRIPTEN_KEEPALIVE void ejs_link_cable_start(int is_host)
+{
+   gb_packet_serial.start(is_host ? 0 : 1, ejs_netpacket_send_cb, ejs_netpacket_poll_cb);
+   gb.setSerialIO(&gb_packet_serial);
+   if (is_host) {
+      gb_packet_serial.connect(1);
+   }
+}
+
+EMSCRIPTEN_KEEPALIVE void ejs_link_cable_receive(int kind, int data, int fast)
+{
+   unsigned char buf[3] = { (unsigned char)kind, (unsigned char)data, (unsigned char)fast };
+   gb_packet_serial.receive(buf, 3, 1);
+}
+
+EMSCRIPTEN_KEEPALIVE void ejs_link_cable_stop(void)
+{
+   gb_packet_serial.stop();
+   gb.setSerialIO(NULL);
+}
+}
+#endif
+
 static bool libretro_supports_option_categories = false;
 static bool libretro_supports_bitmasks          = false;
 static bool libretro_supports_set_variable      = false;
