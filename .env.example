# ==============================================================================
# ROM Vault Environment Configuration
# Copy this file to .env.local or .env in production
#
# IMPORTANT:
# All hostnames, URLs, credentials, and email addresses below are generalized
# placeholders. Replace them with your actual production infrastructure values.
# ==============================================================================

# Node Environment & Port
NODE_ENV=production
PORT=39254

# Storage Locations (ROM binaries, disc images, and multi-layer artwork)
STORAGE_ROOT=/mnt/storage/oldsmarchaos.com/roms
SAVES_DIR=/mnt/storage/oldsmarchaos.com/roms/saves

# Database Connection (MariaDB / MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=rom_vault_user
DB_PASSWORD=your_database_password_here
DB_NAME=rom_vault

# SMTP Mail Configuration (Password Resets, Account Verification)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=support@example.com
SMTP_PASS=your_smtp_app_password
SMTP_FROM="ROM Vault <support@example.com>"

# Application URLs & Authentication
NEXT_PUBLIC_APP_URL=https://your-domain.example.com/roms
AUTH_SESSION_COOKIE_NAME=rom_vault_session
SESSION_SECRET=generate_a_random_64_char_hex_secret_here
SESSION_MAX_AGE_DAYS=14

# Admin Bootstrap Configuration (comma-separated list granted admin role upon registration)
ADMIN_USERNAMES=admin
ADMIN_EMAILS=admin@example.com,support@example.com

# IGDB / Twitch API Credentials (Optional: for automated artwork and metadata enrichment)
# TWITCH_CLIENT_ID=your_twitch_client_id_here
# TWITCH_CLIENT_SECRET=your_twitch_client_secret_here
