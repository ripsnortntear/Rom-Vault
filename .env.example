# ==============================================================================
# ROM Vault Environment Configuration
# Copy this file to .env.local or .env in production
# ==============================================================================

# Database Connection (MariaDB / MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=cfw34683
DB_PASSWORD=your_database_password_here
DB_NAME=rom_vault

# Zoho Mail SMTP Configuration
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=support@oldsmarchaos.com
SMTP_PASS=your_zoho_smtp_app_password
SMTP_FROM="ROM Vault <support@oldsmarchaos.com>"

# Application URLs & Security
NEXT_PUBLIC_APP_URL=https://www.oldsmarchaos.com/roms
AUTH_SESSION_COOKIE_NAME=rom_vault_session
AUTH_SECRET=generate_a_random_64_char_hex_secret_here
SESSION_MAX_AGE_DAYS=14

# Admin Bootstrap Configuration (comma-separated list of usernames or emails granted admin on registration)
ADMIN_USERNAMES=cfw34683
ADMIN_EMAILS=admin@oldsmarchaos.com,support@oldsmarchaos.com
