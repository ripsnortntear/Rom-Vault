# ==============================================================================
# ROM Vault — Complete Environment Configuration Template
# ==============================================================================
# Copy this file to `.env.local` (or `.env`) in the project root:
#   cp .env.example .env.local && chmod 600 .env.local
#
# All domains, URLs, hostnames, emails, credentials, and storage mount points
# are controlled here — no source code edits are required.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Runtime & Public URLs
# ------------------------------------------------------------------------------
NODE_ENV=production
# Port the Next.js server listens on (matches deploy/retro-gaming.service)
PORT=39254

# Full public base URL including the /roms basePath (used for OAuth, emails, OG cards)
NEXT_PUBLIC_APP_URL=https://your-domain.example.com/roms
# Optional bare domain used in UI links/redirects (defaults to host from NEXT_PUBLIC_APP_URL)
NEXT_PUBLIC_APP_DOMAIN=your-domain.example.com
# Optional internal/CLI base URL override (used by scan/sync scripts)
ROM_VAULT_URL=https://your-domain.example.com/roms
# Optional external status/monitoring page linked from the header
NEXT_PUBLIC_STATUS_PAGE_URL=https://status.example.com

# Comma-separated CORS origins & allowed host headers (leave aligned with your domain)
ALLOWED_ORIGINS=https://your-domain.example.com
ALLOWED_HOST=your-domain.example.com
ALLOWED_HOSTS=your-domain.example.com,localhost,127.0.0.1

# ------------------------------------------------------------------------------
# 2. Storage Pool & ROM Directories (Absolute Paths Recommended)
# ------------------------------------------------------------------------------
# Root directory containing per-system folders (<system>/roms and <system>/artwork)
STORAGE_ROOT=/path/to/roms
# Directory for user virtual memory cards (.mcr, .ps2) and universal cloud saves (.srm, .state)
SAVES_DIR=/path/to/roms/saves

# Optional Neo Geo directory overrides (used by scripts/setup-neogeo.mjs)
# NEOGEO_ROMS_DIR=/path/to/roms/neogeo/roms
# NEOGEO_ARTWORK_DIR=/path/to/roms/neogeo/artwork

# ------------------------------------------------------------------------------
# 3. MariaDB / MySQL Database
# ------------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=rom_vault_user
DB_PASSWORD=your_database_password_here
DB_NAME=rom_vault

# ------------------------------------------------------------------------------
# 4. Authentication, Sessions & Admin Bootstrap
# ------------------------------------------------------------------------------
AUTH_SESSION_COOKIE_NAME=rom_vault_session
# Generate a 64-char hex secret:  openssl rand -hex 32
SESSION_SECRET=generate_a_random_64_char_hex_secret_here
# Optional Bearer token for internal automation/preview scripts (e.g. openssl rand -hex 32)
AUTH_SECRET=generate_a_random_64_char_hex_secret_here
SESSION_MAX_AGE_DAYS=14

# Comma-separated usernames automatically granted admin role on registration
ADMIN_USERNAMES=admin
# Primary/root administrator username for protected admin operations
INITIAL_ADMIN_USERNAME=admin
ROOT_ADMIN_USER=admin

# Admin email addresses for system alerts & dual-admin registration approval notifications
ADMIN_EMAIL=admin@example.com
ADMIN_EMAILS=admin@example.com,support@example.com
ADMIN_NOTIFICATION_EMAILS=admin@example.com,support@example.com

# ------------------------------------------------------------------------------
# 5. SMTP Email (Account Verification, Password Resets, Admin Approvals)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# Set to "true" for port 465 (SSL/TLS), "false" for port 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=support@example.com
SMTP_PASS=your_smtp_app_password_here
SMTP_FROM="ROM Vault <support@example.com>"

# ------------------------------------------------------------------------------
# 6. Metadata & Artwork Enrichment APIs (Optional)
# ------------------------------------------------------------------------------
# IGDB / Twitch OAuth2 (https://dev.twitch.tv/console/apps)
# TWITCH_CLIENT_ID=your_twitch_client_id_here
# TWITCH_CLIENT_SECRET=your_twitch_client_secret_here

# SteamGridDB API Key (https://www.steamgriddb.com/profile/preferences/api)
# STEAMGRIDDB_API_KEY=your_steamgriddb_api_key_here

# TheGamesDB API Key (https://api.thegamesdb.net/)
# THEGAMESDB_API_KEY=your_thegamesdb_api_key_here

# ------------------------------------------------------------------------------
# 7. Optional Fleet / Homelab Integrations (Jellyfin SSO, FileBot, Seedbox)
# ------------------------------------------------------------------------------
# Jellyfin SSO account synchronization
# JELLYFIN_INTERNAL_URL=http://127.0.0.1:8096
# JELLYFIN_PUBLIC_URL=https://jellyfin.example.com
# JELLYFIN_API_KEY=your_jellyfin_api_key_here
# JELLYFIN_SERVER_NAME=ROM Vault Media

# FileBot WebUI / htpasswd synchronization
# FILEBOT_CONTAINER_NAME=filebot
# FILEBOT_HTPASSWD_PATH=/path/to/filebot/htpasswd
# FILEBOT_ADMIN_USER=admin
# FILEBOT_ADMIN_PASSWORD=your_filebot_admin_password

# Admin Seedbox / ZFS / Docker Compose inspection paths (Admin Console only)
# SEEDBOX_BASE_DIR=/path/to/seedbox
# ZFS_SEEDBOX_POOL=tank/seedbox
# ADMIN_COMPOSE_PATH=/path/to/docker-compose.yml
